        "    WHEN 'Brisbane' THEN 'Australia'\r\n",
        "    WHEN 'Toronto' THEN 'Canada'\r\n",
        "    WHEN 'Vancouver' THEN 'Canada'\r\n",
        "    WHEN 'Montreal' THEN 'Canada'\r\n",
        "    WHEN 'Berlin' THEN 'Germany'\r\n",
        "    WHEN 'Munich' THEN 'Germany'\r\n",
        "    WHEN 'Frankfurt' THEN 'Germany'\r\n",
        "    WHEN 'Madrid' THEN 'Spain'\r\n",
        "    WHEN 'Barcelona' THEN 'Spain'\r\n",
        "    WHEN 'Valencia' THEN 'Spain'\r\n",
        "    WHEN 'Rome' THEN 'Italy'\r\n",
        "    WHEN 'Milan' THEN 'Italy'\r\n",
        "    WHEN 'Naples' THEN 'Italy'\r\n",
        "    WHEN 'Beijing' THEN 'China'\r\n",
        "    WHEN 'Shanghai' THEN 'China'\r\n",
        "    WHEN 'Guangzhou' THEN 'China'\r\n",
        "    WHEN 'Moscow' THEN 'Russia'\r\n",
        "    WHEN 'Saint Petersburg' THEN 'Russia'\r\n",
        "    WHEN 'Novosibirsk' THEN 'Russia'\r\n",
        "    WHEN 'Delhi' THEN 'India'\r\n",
        "    WHEN 'Mumbai' THEN 'India'\r\n",
        "    WHEN 'Bangalore' THEN 'India'\r\n",
        "    -- add more mappings as needed\r\n",
        "    ELSE 'Unknown'\r\n",
        "  END AS country\r\n",
        "FROM workspace.default.accuweather_notebook_daily"
