        "    WHEN 'Tokyo' THEN 'Japan'\r\n",
        "    WHEN 'Osaka' THEN 'Japan'\r\n",
        "    WHEN 'Nagoya' THEN 'Japan'\r\n",
        "    WHEN 'Sydney' THEN 'Australia'\r\n",
